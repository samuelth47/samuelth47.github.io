+/* Professional portfolio refinements */
+
+.page__content {
+  max-width: 900px;
+}
+
+.home-hero {
+  background: linear-gradient(135deg, #f4f8ff 0%, #ffffff 72%);
+  border: 1px solid #dce7f5;
+  border-left: 4px solid #2f6fbd;
+  border-radius: 12px;
+  padding: 2rem 2.25rem;
+  margin-bottom: 2rem;
+}
+
+.home-hero__eyebrow {
+  color: #2f6fbd;
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  margin-bottom: 0.75rem;
+}
+
+.home-hero h1 {
+  font-size: clamp(2rem, 4vw, 3.1rem);
+  line-height: 1.08;
+  margin: 0 0 0.85rem;
+}
+
+.home-hero p {
+  font-size: 1.08rem;
+  line-height: 1.7;
+  margin-bottom: 0;
+  max-width: 720px;
+}
+
+.home-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  margin-top: 1.4rem;
+}
+
+.home-actions a {
+  border: 1px solid #2f6fbd;
+  border-radius: 6px;
+  display: inline-block;
+  font-weight: 700;
+  padding: 0.65rem 1rem;
+  text-decoration: none;
+}
+
+.home-actions a:first-child {
+  background: #2f6fbd;
+  color: #fff;
+}
+
+.home-actions a:not(:first-child) {
+  color: #2f6fbd;
+}
+
+.home-section-title {
+  border-bottom: 1px solid #e2e8f0;
+  margin-top: 2.1rem;
+  padding-bottom: 0.55rem;
+}
+
+.home-skill-grid,
+.home-project-grid {
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  margin-top: 1rem;
+}
+
+.home-skill-card,
+.home-project-card {
+  background: #fff;
+  border: 1px solid #e2e8f0;
+  border-radius: 8px;
+  padding: 1rem 1.1rem;
+}
+
+.home-skill-card strong,
+.home-project-card strong {
+  color: #26384d;
+  display: block;
+  margin-bottom: 0.35rem;
+}
+
+.home-skill-card span,
+.home-project-card p {
+  color: #536273;
+  font-size: 0.92rem;
+  line-height: 1.55;
+}
+
+.home-project-card p {
+  margin: 0 0 0.65rem;
+}
+
+.home-project-card a {
+  font-size: 0.9rem;
+  font-weight: 700;
+}
+
+@media (max-width: 600px) {
+  .home-hero {
+    padding: 1.35rem;
+  }
+
+  .home-skill-grid,
+  .home-project-grid {
+    grid-template-columns: 1fr;
+  }
+}
